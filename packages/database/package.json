{
  "name": "@manara/database",
  "version": "0.1.0",
  "private": true,
  "description": "Manara database infrastructure — PostgreSQL via pg, transactions, migrations, readiness",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/migrations/sql','dist/migrations/sql',{recursive:true})\"",
    "migrate": "node dist/migrations/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@manara/config": "*",
    "pg": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@manara/eslint-config": "*",
    "@manara/tsconfig": "*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3"
  }
}
