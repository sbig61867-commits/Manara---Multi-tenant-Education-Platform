{
  "name": "@manara/config",
  "version": "0.1.0",
  "private": true,
  "description": "Environment loading and Zod-validated configuration for Manara services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@manara/eslint-config": "*",
    "@manara/tsconfig": "*",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}
