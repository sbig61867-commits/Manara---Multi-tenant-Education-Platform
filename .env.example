# Manara environment contract
# Copy to .env for local development. Real process environment overrides files.
# Never commit .env or .env.local.

# --- Shared server-only ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Keep false for structured JSON logs. Set true only for local human-readable logs.
LOG_PRETTY=false

# --- Web public (included in the browser bundle; never place secrets here) ---
# Optional in development/test, where relative requests use the Vite proxy.
# Required as an absolute HTTPS origin in staging/production.
VITE_API_BASE_URL=https://api.example.com
# Development server only.
WEB_PORT=5173

# --- API server-only ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
API_DATABASE_POOL_MAX=5
# Comma-separated exact frontend origins; required and HTTPS in staging/production.
API_CORS_ORIGINS=https://app.example.com
API_BODY_LIMIT_BYTES=1048576
API_ENABLE_DOCS=auto
API_COOKIE_SECURE=auto
API_COOKIE_NAME=manara_session
# off/false disables trust; otherwise use 1..16 fixed hops or explicit proxy IP/CIDRs.
# Never use unrestricted true in staging/production.
API_TRUST_PROXY=off

# Authentication abuse protection (in-memory, per API instance).
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_EMAIL_IP_MAX_FAILURES=5
AUTH_LOGIN_EMAIL_IP_WINDOW_MS=900000
AUTH_REFRESH_IP_MAX_REQUESTS=30
AUTH_REFRESH_IP_WINDOW_MS=900000
AUTH_ENDPOINT_IP_MAX_REQUESTS=120
AUTH_ENDPOINT_IP_WINDOW_MS=900000

# --- Worker server-only ------------------------------------------------------
WORKER_HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
WORKER_DATABASE_POOL_MAX=2
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_CLAIM_LEASE_MS=300000
WORKER_STALE_CLAIM_RELEASE_INTERVAL_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
WORKER_CLAIM_SCOPE=platform
# Set only when WORKER_CLAIM_SCOPE=tenant.
# WORKER_CLAIM_TENANT_ID=00000000-0000-4000-8000-000000000000

# --- Database and administrative commands (server-only secret) --------------
# Required by the worker, migration/permission commands, and staging/production API.
# Supply the real value through a secret manager; never expose it as VITE_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
