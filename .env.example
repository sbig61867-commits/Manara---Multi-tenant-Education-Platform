# =============================================================================
# Manara — shared environment template
# Copy to .env (and optionally .env.local for local overrides).
# .env.local wins over .env; real process environment wins over both.
# Never commit .env or .env.local (see .gitignore).
# =============================================================================

# --- Shared -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# true = human-readable pretty logs (dev); false = raw JSON (production)
LOG_PRETTY=true

# --- API (apps/api) ----------------------------------------------------------
API_HOST=0.0.0.0
# API server port; also used by the Vite dev server proxy target (apps/web)
API_PORT=3000
# Authentication abuse protection (in-memory, per API instance):
# failed-login attempts allowed per client IP within the window
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_IP_WINDOW_MS=900000
# failed-login attempts allowed per normalized email + client IP within the window
AUTH_LOGIN_EMAIL_IP_MAX_FAILURES=5
AUTH_LOGIN_EMAIL_IP_WINDOW_MS=900000
# invalid/expired session refresh attempts allowed per client IP within the window
AUTH_REFRESH_IP_MAX_REQUESTS=30
AUTH_REFRESH_IP_WINDOW_MS=900000
# logout and session requests allowed per client IP within the window (lighter policy)
AUTH_ENDPOINT_IP_MAX_REQUESTS=120
AUTH_ENDPOINT_IP_WINDOW_MS=900000
# Authentication abuse protection (in-memory, per API instance):
# failed-login attempts allowed per client IP within the window
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_IP_WINDOW_MS=900000
# failed-login attempts allowed per normalized email + client IP within the window
AUTH_LOGIN_EMAIL_IP_MAX_FAILURES=5
AUTH_LOGIN_EMAIL_IP_WINDOW_MS=900000
# invalid/expired session refresh attempts allowed per client IP within the window
AUTH_REFRESH_IP_MAX_REQUESTS=30
AUTH_REFRESH_IP_WINDOW_MS=900000
# logout and session requests allowed per client IP within the window (lighter policy)
AUTH_ENDPOINT_IP_MAX_REQUESTS=120
AUTH_ENDPOINT_IP_WINDOW_MS=900000

# --- Worker (apps/worker) ----------------------------------------------------
WORKER_HOST=0.0.0.0
WORKER_HEALTH_PORT=3001

# --- Web (apps/web) ----------------------------------------------------------
# Used by Vite dev server
WEB_PORT=5173

# --- Database (packages/database) --------------------------------------------
# Standard PostgreSQL via the pg driver; read from DATABASE_URL only.
# When unset, the API boots with database readiness unavailable.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manara
