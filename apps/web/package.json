{
  "name": "@manara/web",
  "version": "0.1.0",
  "private": true,
  "description": "Manara web application — React 19 + Vite SPA, Arabic-first RTL",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --allowImportingTsExtensions && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --allowImportingTsExtensions",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@manara/contracts": "*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@manara/eslint-config": "*",
    "@manara/tsconfig": "*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
